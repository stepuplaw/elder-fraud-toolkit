{
  "name": "elder-fraud-toolkit",
  "version": "0.1.0",
  "description": "Automates the mail- and phone-based steps from a real elder-fraud-prevention checklist: protected-consumer credit-freeze letters (self-service or for a guardian/conservator/POA agent) plus click-to-call and save-to-contacts for every relevant hotline. One dependency (a client-side QR encoder), nothing ever leaves the browser.",
  "keywords": [
    "elder-fraud",
    "credit-freeze",
    "power-of-attorney",
    "guardianship",
    "protected-consumer",
    "identity-theft",
    "fintech",
    "legal-tech",
    "vcard",
    "qr-code"
  ],
  "homepage": "https://stepuplaw.com/florida-elder-abuse-attorney",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stepuplaw/elder-fraud-toolkit.git"
  },
  "bugs": {
    "url": "https://github.com/stepuplaw/elder-fraud-toolkit/issues"
  },
  "author": "Kevin D. Klagge, Esq. <office@stepuplaw.com> (https://stepuplaw.com)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "pretest": "npm run build",
    "test": "node --test"
  },
  "dependencies": {
    "qrcode-generator": "^2.0.4"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
